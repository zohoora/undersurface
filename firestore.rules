rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The user root doc carries server-written account state (the deletion
    // tombstone). The client never writes it; only the Admin SDK does.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Everything under users/{uid}. Firestore unions every matching `allow`,
    // so server-owned collections must be excluded HERE rather than denied in
    // a separate, more specific block:
    // - smsSettings: phone-link state, SMS risk state, opt-out time, usage
    //   budget. Written only by the SMS functions.
    // - smsMessages: the SMS transcript, written only by the SMS functions.
    // - folioPages, folioTraces: Folio's pages and kept things have their own
    //   rules below (compare-and-swap on a revision chain; immutable kept
    //   fields), so they are carved out of the generic owner write too.
    // The owner keeps read access to all of these, and keeps write access to
    // every other collection (including companionPreferences, where the web
    // client writes field-window consent and lastGroundingAt).
    match /users/{userId}/{collectionId}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && !(collectionId in ['smsSettings', 'smsMessages', 'folioPages', 'folioTraces']);
    }

    // Folio pages (docs/vision/2026-10-15-folio-v4.md §5.2, C2). A write is
    // accepted only if it was built on the revision the server holds, so a
    // save from a stale device or tab is rejected rather than overwriting.
    // Revision ids are random and chained, so every later write built on a
    // rejected one is rejected too.
    function validPage(pageId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'createdAt', 'updatedAt', 'doc', 'schemaVersion', 'revId',
                               'parentRevId', 'rev', 'editorId', 'preview', 'foldCount', 'safety', 'notes'])
        && d.id == pageId
        && d.doc is string && d.doc.size() <= 950000
        && d.revId is string && d.revId.size() > 0 && d.revId.size() <= 40
        && 'parentRevId' in d
        && (d.parentRevId == null || d.parentRevId is string)
        && d.safety is map && d.safety.checked is list && d.safety.checked.size() <= 12000
        && (!('notes' in d) || (d.notes is list && d.notes.size() <= 50));
    }

    match /users/{userId}/folioPages/{pageId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validPage(pageId)
        && request.resource.data.parentRevId == null;
      allow update: if isOwner(userId) && validPage(pageId)
        && request.resource.data.parentRevId == resource.data.revId
        && request.resource.data.revId != resource.data.revId;
      allow delete: if isOwner(userId);
    }

    // Folio's kept things (draft 4 §5.3, C3). The app never rewrites a kept
    // field: an update may change only the title (and who named it), the
    // come-back fields and the checked set. `keptBy` is set at create only. Entries are added and deleted, never edited.
    function validTrace(traceId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'keptAt', 'source', 'previousTraceId', 'correctedFromId', 'surface', 'gap',
                               'composition', 'author', 'title', 'comeBackAt', 'comeBackTz', 'comeBackSetAt',
                               'lastComeBackShownAt', 'groundedNearKeep', 'safety', 'schemaVersion',
                               'returnEligible', 'lastReturnShownAt', 'keptBy', 'titleBy'])
        && d.id == traceId
        && d.author == 'writer'
        && d.keptAt is int
        && d.source is map && d.source.pageId is string && d.source.foldId is string
        && d.surface is string && d.surface.size() <= 2000
        && d.composition is string && d.composition.size() <= 950000
        && d.gap is int && d.gap >= 0 && d.gap <= 4
        && d.groundedNearKeep is bool
        && d.safety is map && d.safety.checked is list && d.safety.checked.size() <= 1000
        && (!('title' in d) || (d.title is string && d.title.size() <= 200))
        && (!('returnEligible' in d) || d.returnEligible is bool)
        // Companion involvement: who kept it and who named it (the words are the writer's).
        && (!('keptBy' in d) || d.keptBy == 'companion')
        && (!('titleBy' in d) || d.titleBy == null || d.titleBy == 'companion');
    }

    match /users/{userId}/folioTraces/{traceId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validTrace(traceId);
      allow update: if isOwner(userId) && validTrace(traceId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'titleBy', 'comeBackAt', 'comeBackTz', 'comeBackSetAt', 'lastComeBackShownAt', 'safety',
                       'returnEligible', 'lastReturnShownAt']);
      allow delete: if isOwner(userId);

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'addedAt', 'text', 'author'])
          && request.resource.data.id == entryId
          && request.resource.data.author == 'writer'
          && request.resource.data.addedAt is int
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 20000;
        allow delete: if isOwner(userId);
      }
    }

    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Durable token quota. The owner may READ their own usage (for a future
    // "remaining budget" UI) but NEVER write it — only the chat Cloud Function
    // (Admin SDK) mutates it, so a user can't reset their own cap.
    match /quotas/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /contactMessages/{msgId} {
      allow read, write: if false;
    }

    // Twilio linkage and delivery queues are server-owned. User-visible SMS
    // messages live under users/{uid}/smsMessages (owner read-only).
    match /smsPhoneLinks/{docId} {
      allow read, write: if false;
    }
    match /smsLinkCodes/{docId} {
      allow read, write: if false;
    }
    match /smsInbound/{docId} {
      allow read, write: if false;
    }
    match /fieldWindowDispatches/{docId} {
      allow read, write: if false;
    }
  }
}
