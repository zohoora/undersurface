rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Soundscapes are content-addressed by sha256(normalized prompt). The
    // cache is shared across the userbase. Reads require auth as
    // defense-in-depth in case a signed URL leaks; writes are Admin-SDK
    // only (the soundscapeApi Cloud Function).
    match /soundscapes/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default-deny everything else.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
