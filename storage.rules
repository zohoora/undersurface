rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Legacy custom-soundscape cache, content-addressed by sha256(normalized
    // prompt) and shared across the userbase. Its only writer, the
    // soundscapeApi Cloud Function, was removed on 2026-10-14; the existing
    // objects were left in place for the owner. Reads require auth as
    // defense-in-depth in case a signed URL leaks; client writes are denied.
    match /soundscapes/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Private moment images are written by the trusted SMS function. The
    // owning client may read bytes with its Firebase credential; clients may
    // never write or replace these objects directly.
    match /field-moments/{uid}/{path=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Default-deny everything else.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
