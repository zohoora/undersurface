{
  "name": "undersurface",
  "private": true,
  "version": "1.0.0",
  "description": "A diary app where inner voices respond as you write",
  "author": "zohoora",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:indexes": "firebase emulators:exec --only firestore 'npx vitest run --config vitest.config.integration.ts'",
    "test:crisis": "RUN_CRISIS_EVAL=1 vitest run src/engine/crisisClassifier.live.test.ts",
    "test:signals": "RUN_SIGNAL_EVAL=1 vitest run src/engine/signalClassifier.live.test.ts",
    "test:parts": "RUN_PARTS_EVAL=1 vitest run src/engine/partObservations.live.test.ts",
    "test:intentions": "RUN_INTENTIONS_EVAL=1 vitest run src/engine/intentionExtraction.live.test.ts",
    "test:stance": "RUN_STANCE_EVAL=1 vitest run src/engine/stanceObservation.live.test.ts",
    "smoke-test": "bash scripts/smoke-test.sh",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:run:ios": "npm run build && npx cap sync ios && npx cap run ios",
    "cap:run:android": "npm run build && npx cap sync android && npx cap run android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@sentry/react": "^10.53.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.3",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.9.0",
    "firebase-tools": "^15.17.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
}
